[Unit]
Description=Control Tower application and Nginx log reader
After=docker.service

[Service]
Type=simple
User=root
Group=ct-agent
EnvironmentFile=-/etc/control-tower/log-reader.env
ExecStart=/usr/local/bin/control-tower-log-reader
RuntimeDirectory=control-tower-log-reader
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
Nice=10
CPUWeight=10
IOWeight=10
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/control-tower-log-reader

[Install]
WantedBy=multi-user.target
